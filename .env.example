# Public Expo variables (safe to embed in the web bundle)
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Set these as Convex deployment environment variables, not in a client build:
# npx convex env set CLERK_SECRET_KEY sk_replace_me
# npx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-clerk-domain.clerk.accounts.dev
# npx convex env set CLOUDFLARE_AI_WORKER_URL https://github-stars-categorizer.your-account.workers.dev
# npx convex env set CLOUDFLARE_AI_SERVICE_TOKEN replace_with_a_long_random_secret
#
# Optional paid-provider fallbacks:
# npx convex env set ANTHROPIC_API_KEY replace_me
# npx convex env set OPENAI_API_KEY replace_me
# npx convex env set CEREBRAS_API_KEY replace_me
