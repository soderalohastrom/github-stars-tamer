{
  "name": "star-shelf",
  "version": "1.0.0",
  "description": "A free, AI-assisted catalog for organizing GitHub stars.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build:all": "eas build --platform all",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "web:build": "EXPO_ROUTER_APP_ROOT=\"$PWD/app\" EXPO_ROUTER_IMPORT_MODE=sync expo export --platform web --output-dir dist",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run web:build",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "worker:dev": "npm --prefix worker run dev",
    "worker:test": "npm --prefix worker test",
    "worker:deploy": "npm --prefix worker run deploy",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.20.0",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "5.2.1",
    "convex": "^1.45.0",
    "expo": "^57.0.16",
    "expo-auth-session": "~57.0.9",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.14",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.15",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.16",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "nanoid": "^6.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.87.0",
    "react-native-draggable-flatlist": "^4.0.1",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "^0.21.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.12.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~56.0.0",
    "convex-test": "^0.0.54",
    "typescript": "~6.0.3",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "packageManager": "npm@11.17.0",
  "private": true
}
