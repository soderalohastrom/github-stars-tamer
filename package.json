{
  "name": "star-shelf",
  "version": "1.0.0",
  "description": "A free, AI-assisted catalog for organizing GitHub stars.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build:all": "eas build --platform all",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "web:build": "EXPO_ROUTER_APP_ROOT=\"$PWD/app\" EXPO_ROUTER_IMPORT_MODE=sync expo export --platform web --output-dir dist",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run web:build",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "worker:dev": "npm --prefix worker run dev",
    "worker:test": "npm --prefix worker test",
    "worker:deploy": "npm --prefix worker run deploy",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.19.42",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "5.2.0",
    "convex": "^1.42.3",
    "expo": "^56.0.0",
    "expo-auth-session": "~56.0.16",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.22",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.24",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-linking": "~56.0.16",
    "expo-router": "~56.2.16",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "expo-web-browser": "~56.0.6",
    "nanoid": "^3.3.11",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-draggable-flatlist": "^4.0.1",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~56.0.0",
    "convex-test": "^0.0.54",
    "typescript": "~7.0.2",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "packageManager": "npm@11.17.0",
  "private": true
}
